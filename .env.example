# ==============================================================================
# Patient360: Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Patient360 Healthcare Intelligence Platform"
API_V1_STR="/api/v1"

# Server Bind Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=patient360_development_insecure_secret_key_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=patient360_user
POSTGRES_PASSWORD=patient360_local_password
POSTGRES_DB=patient360_db
# SQLite Fallback for offline testing / development when Docker is not running:
# DATABASE_URL=sqlite:///./patient360_dev.db
DATABASE_URL=postgresql+psycopg2://patient360_user:patient360_local_password@localhost:5432/patient360_db

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=patient360_chunks

# FastEmbed / Embedding Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# LLM Provider Configuration (Multi-Provider Gateway: mock, gemini, ollama)
# Options: mock, gemini, ollama
LLM_PROVIDER=mock

# Gemini API Configuration (Free Tier: gemini-3.5-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Ollama Configuration (Offline: qwen3:4b via localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60
LLM_FALLBACK_TO_MOCK=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Storage Directory
STORAGE_LOCAL_PATH=./storage/documents

# Ingestion Limits
MAX_UPLOAD_SIZE_MB=25
MAX_CONTEXT_TOKENS=2000
