{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://patient360-backend.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://patient360-backend.onrender.com/api"
    },
    {
      "source": "/health",
      "destination": "https://patient360-backend.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://patient360-backend.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://patient360-backend.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
