{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://patient360-backend-442154825091.us-central1.run.app/api/:match*"
    },
    {
      "source": "/health",
      "destination": "https://patient360-backend-442154825091.us-central1.run.app/health"
    },
    {
      "source": "/docs",
      "destination": "https://patient360-backend-442154825091.us-central1.run.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://patient360-backend-442154825091.us-central1.run.app/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
